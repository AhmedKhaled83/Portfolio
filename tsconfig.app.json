{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true, // Add this - allows importing JS files
    "checkJs": false, // Add this - skips type checking JS files
    "verbatimModuleSyntax": false, // Change to false for JS/JSX imports
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "noUnusedLocals": false, // Change to false temporarily
    "noUnusedParameters": false, // Change to false temporarily
    "erasableSyntaxOnly": false, // Change to false for JSX
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src"
  ]
}